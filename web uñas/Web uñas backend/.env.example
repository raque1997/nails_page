# Copia a .env y completa. NUNCA subas .env a git.

PORT=3001
NODE_ENV=development
# Origen(es) del frontend permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Service Account (valores del .json descargado de Google Cloud)
# client_email -> GOOGLE_CLIENT_EMAIL
GOOGLE_CLIENT_EMAIL=booking-api@tu-proyecto.iam.gserviceaccount.com
# private_key -> GOOGLE_PRIVATE_KEY: en UNA línea, entre comillas dobles, con los \n literales
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Calendario compartido con el correo de la Service Account
# (permiso "Hacer cambios en eventos"). Normalmente tu Gmail.
GOOGLE_CALENDAR_ID=tu-correo@gmail.com

# Correos de confirmación (opcional: si falta alguno, no se envían correos)
# Cuenta Gmail que envía los correos
GMAIL_USER=tu-correo@gmail.com
# Contraseña de aplicación (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
GMAIL_APP_PASSWORD=
# Quién recibe el aviso de cada nueva cita
OWNER_EMAIL=tu-correo@gmail.com

BUSINESS_TIMEZONE=America/El_Salvador
BUSINESS_UTC_OFFSET=-06:00
